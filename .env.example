# Copy to .env for local runs outside Docker (uv run uvicorn ...).
ENVIRONMENT=local
LOG_LEVEL=INFO
ACCESS_LOG=true

# Postgres from `docker compose up -d db`.
DATABASE_URL=postgresql://app:app@localhost:5432/seats
DB_POOL_MAX_SIZE=10
DB_POOL_ACQUIRE_TIMEOUT=45
DB_READY_TIMEOUT=1
DB_STATEMENT_TIMEOUT_MS=15000
DB_PROBE_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=10000
DB_ECHO=false

# Auth. These dev values are refused when ENVIRONMENT=production.
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_TTL_SECONDS=86400
ADMIN_TOKEN=dev-admin-token

SOLD_SEAT_CACHE_ENABLED=true
SOLD_SEAT_CACHE_TTL_SECONDS=30

DEFAULT_PER_USER_LIMIT=4
MAX_SEATS_PER_SHOW=20000
